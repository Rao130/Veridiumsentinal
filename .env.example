APP_NAME=VeridiumSentinel
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
SESSION_COOKIE_NAME=vs_session
SESSION_COOKIE_SECURE=
FRONTEND_BASE_URL=http://localhost:3000
ACTION_TOKEN_EXPIRE_MINUTES=30
SCAN_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0
ENABLE_LOCAL_DEMO_TARGETS=false
SCANNER_CREDENTIALS_KEY=
MAX_ACTIVE_SCANS_PER_ORG=3
MAX_SCANS_PER_ORG_PER_DAY=50
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
